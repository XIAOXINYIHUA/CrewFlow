# CrewFlow 环境变量配置
# 复制为 .env 后填写

# ── API Keys ──
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1

# 搜索 API (PR 2 启用)
# TAVILY_API_KEY=your-tavily-api-key

# ── 模型路由 (可选, 不填使用默认值) ──
# CREWFLOW_PLANNER_MODEL=gpt-4o-mini
# CREWFLOW_RESEARCHER_MODEL=gpt-4o-mini
# CREWFLOW_WRITER_MODEL=gpt-4o-mini
# CREWFLOW_REVIEWER_MODEL=gpt-4o-mini
# CREWFLOW_CLAIM_BUILDER_MODEL=gpt-4o-mini
# CREWFLOW_FACT_CHECKER_MODEL=gpt-4o-mini

# ── 运行时参数 ──
# CREWFLOW_MAX_ITERATIONS=3
# CREWFLOW_MAX_QUERIES=12
# CREWFLOW_MAX_SOURCES=30
# CREWFLOW_MAX_BUDGET_USD=
# CREWFLOW_REQUEST_TIMEOUT=60
# CREWFLOW_MAX_RETRIES=3

# ── 默认值 ──
# CREWFLOW_DEFAULT_LANGUAGE=zh-CN
# CREWFLOW_TARGET_WORDS=2500

# ── 数据库 ──
# CREWFLOW_DATABASE_URL=sqlite:///data/crewflow.db

# ── 路径 ──
# CREWFLOW_BASE_DIR=

# ── 服务 ──
# CREWFLOW_HOST=0.0.0.0
# CREWFLOW_PORT=8000
